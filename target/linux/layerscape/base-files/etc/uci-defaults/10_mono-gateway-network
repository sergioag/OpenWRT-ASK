#!/bin/sh
#
# Mono Gateway Development Kit - Network Configuration
#
# eth0, eth1, eth2 - LAN (bridged, 192.168.1.0/24, DHCP server)
# eth3 - WAN (DHCP client)
# eth4 - LAN2 (192.168.0.0/24, DHCP server)
#

. /lib/functions.sh

# Only apply to Mono Gateway
case "$(cat /tmp/sysinfo/model 2>/dev/null)" in
	"Mono Gateway Development Kit")
		;;
	*)
		exit 0
		;;
esac

# Network configuration
uci batch <<'EOF'
# Delete any existing bridge device config
delete network.@device[0]

# Create br-lan bridge device
set network.br_lan=device
set network.br_lan.name='br-lan'
set network.br_lan.type='bridge'
add_list network.br_lan.ports='eth0'
add_list network.br_lan.ports='eth1'
add_list network.br_lan.ports='eth2'

# LAN interface (192.168.1.0/24)
set network.lan=interface
set network.lan.device='br-lan'
set network.lan.proto='static'
set network.lan.ipaddr='192.168.1.1'
set network.lan.netmask='255.255.255.0'

# WAN interface (DHCP client)
set network.wan=interface
set network.wan.device='eth3'
set network.wan.proto='dhcp'

# WAN6 interface (DHCPv6 client)
set network.wan6=interface
set network.wan6.device='eth3'
set network.wan6.proto='dhcpv6'

# LAN2 interface (192.168.0.0/24)
set network.lan2=interface
set network.lan2.device='eth4'
set network.lan2.proto='static'
set network.lan2.ipaddr='192.168.0.1'
set network.lan2.netmask='255.255.255.0'
EOF

uci commit network

# DHCP configuration
uci batch <<'EOF'
# LAN DHCP server
set dhcp.lan=dhcp
set dhcp.lan.interface='lan'
set dhcp.lan.start='100'
set dhcp.lan.limit='150'
set dhcp.lan.leasetime='12h'

# Disable DHCP on WAN
set dhcp.wan=dhcp
set dhcp.wan.interface='wan'
set dhcp.wan.ignore='1'

# LAN2 DHCP server
set dhcp.lan2=dhcp
set dhcp.lan2.interface='lan2'
set dhcp.lan2.start='100'
set dhcp.lan2.limit='150'
set dhcp.lan2.leasetime='12h'
EOF

uci commit dhcp

# Firewall configuration
uci batch <<'EOF'
# Add lan2 to lan zone
delete firewall.@zone[0].network
add_list firewall.@zone[0].network='lan'
add_list firewall.@zone[0].network='lan2'
EOF

uci commit firewall

exit 0
