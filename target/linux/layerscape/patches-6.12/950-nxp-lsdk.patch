+static uint32_t pxp_fetch_ctrl_config(struct pxps *pxp,
+				      struct pxp_pixmap *in,
+				      uint8_t mode)
+{
+	const struct pxp_devdata *data = pxp->devdata;
+	struct fetch_ctrl ctrl;
+
+	memset((void*)&ctrl, 0x0, sizeof(ctrl));
+
+	if (mode == FETCH_MODE_NORMAL)
+		ctrl.bypass_pixel_en = 0;
+
+	if (in->flip == PXP_H_FLIP)
+		ctrl.hflip = 1;
+	else if (in->flip == PXP_V_FLIP)
+		ctrl.vflip = 1;
+
+	ctrl.rotation_angle = rotate_map(in->rotate);
+
+	if (in->rotate || in->flip)
+		ctrl.block_en = 1;
+
+	if (data->version < PXP_V4) {
+		ctrl.block_16 = 1;
+		ctrl.rd_num_bytes = 3;
+	} else {
+		ctrl.block_32 = 1;
+		ctrl.rd_num_bytes = 4;
+	}
+
+	ctrl.ch_en = 1;
+
+	return *(uint32_t *)&ctrl;
+}
