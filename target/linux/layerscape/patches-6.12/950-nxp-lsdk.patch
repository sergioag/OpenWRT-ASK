+static int __init __cold fm_load (void)
+{
+    if ((h_FmLnxWrp = LNXWRP_FM_Init()) == NULL)
+    {
+        printk("Failed to init FM wrapper!\n");
+        return -ENODEV;
+    }
+
+	printk(KERN_INFO "Freescale FM module," \
+		" FMD API version %d.%d.%d\n",
+		FMD_API_VERSION_MAJOR,
