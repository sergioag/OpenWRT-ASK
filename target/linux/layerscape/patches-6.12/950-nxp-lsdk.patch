+/******************************************************************************
+ @File          fm_cc.c
+
+ @Description   FM Coarse Classifier implementation
+ *//***************************************************************************/
+#define __ERR_MODULE__ MODULE_FM_PCD
+
+#include <linux/math64.h>
+#include "std_ext.h"
+#include "error_ext.h"
