+struct tsn_port *tsn_get_port(struct net_device *ndev)
+{
+	struct tsn_port *port;
+	bool tsn_found = false;
+
+	list_for_each_entry(port, &port_list, list) {
+		if (port->netdev == ndev) {
+			tsn_found = true;
+			break;
+		}
+	}
+
+	if (!tsn_found)
+		return NULL;
+
+	return port;
