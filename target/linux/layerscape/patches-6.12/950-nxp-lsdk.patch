+	pcp_conf.dpl = nla_get_u32(pcpa[TSN_PCP_ATTR_DPL]);
+
+	ret = tsnops->pcpmap_set(netdev, &pcp_conf);
+
+out:
+	tsn_simple_reply(info, TSN_CMD_REPLY, netdev->name, ret);
+
+	return ret;
+}
